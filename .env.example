# Copy to .env.local (local) and set in the hosting dashboard (production). Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL (used for sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=https://www.porthillguest.co.ke

# Optional: cookie-free analytics via Plausible. Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# WhatsApp booking alerts (Meta Cloud API). Until set, alerts are logged to the server console.
WHATSAPP_ALERT_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=

